@model RaceDay.MVC.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<style>
    body {
        background: #f1f5f9;
        font-family: Arial, sans-serif;
    }

    .register-wrapper {
        max-width: 600px;
        margin: 55px auto;
        padding: 0 15px;
    }

    .register-card {
        background: #ffffff;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .register-header {
        background: #172554;
        color: white;
        text-align: center;
        padding: 35px 20px;
    }

        .register-header h1 {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .register-header h3 {
            font-size: 22px;
            margin-bottom: 8px;
        }

        .register-header p {
            color: #cbd5e1;
            margin: 0;
        }

    .register-body {
        padding: 35px;
    }

    .form-label {
        color: #172554;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

    .register-button {
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 13px;
        width: 100%;
        font-size: 16px;
        font-weight: bold;
        transition: background 0.2s;
    }

        .register-button:hover {
            background: #1d4ed8;
        }

    .register-links {
        text-align: center;
        margin-top: 25px;
    }

        .register-links a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

            .register-links a:hover {
                text-decoration: underline;
            }

    .back-link {
        display: inline-block;
        margin-top: 12px;
        color: #64748b !important;
    }

    @@media (max-width: 576px) {
        .register-body {
            padding: 25px 20px;
        }

        .register-wrapper {
            margin: 25px auto;
        }
    }
</style>

<div class="register-wrapper">
    <div class="register-card">

        <div class="register-header">
            <h1>RaceDay</h1>
            <h3>Create Your Account</h3>
            <p>Join RaceDay and start your journey.</p>
        </div>

        <div class="register-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form action="/Account/Register" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="FirstName" class="form-label">
                        First Name
                    </label>
                    <input id="FirstName"
                           name="FirstName"
                           type="text"
                           class="form-control"
                           placeholder="Enter your first name"
                           value="@Model?.FirstName"
                           required />
                </div>

                <div class="mb-3">
                    <label for="LastName" class="form-label">
                        Last Name
                    </label>
                    <input id="LastName"
                           name="LastName"
                           type="text"
                           class="form-control"
                           placeholder="Enter your last name"
                           value="@Model?.LastName"
                           required />
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label">
                        Email Address
                    </label>
                    <input id="Email"
                           name="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email address"
                           value="@Model?.Email"
                           required />
                </div>

                <div class="mb-3">
                    <label for="PhoneNumber" class="form-label">
                        Phone Number
                    </label>
                    <input id="PhoneNumber"
                           name="PhoneNumber"
                           type="tel"
                           class="form-control"
                           placeholder="Enter your phone number"
                           value="@Model?.PhoneNumber" />
                </div>

                <div class="mb-3">
                    <label for="Password" class="form-label">
                        Password
                    </label>
                    <input id="Password"
                           name="Password"
                           type="password"
                           class="form-control"
                           placeholder="Minimum 8 characters"
                           minlength="8"
                           required />
                </div>

                <div class="mb-4">
                    <label for="Role" class="form-label">
                        Register As
                    </label>

                    <select id="Role"
                            name="Role"
                            class="form-select"
                            required>

                        <option value="Participant"
                                selected="@(Model?.Role != "Organiser" ? "selected" : null)">
                            Participant
                        </option>

                        <option value="Organiser"
                                selected="@(Model?.Role == "Organiser" ? "selected" : null)">
                            Organiser
                        </option>

                    </select>
                </div>

                <button type="submit" class="register-button">
                    Create Account
                </button>

            </form>

            <div class="register-links">
                <p>
                    Already have an account?
                    <a href="/Account/Login">Sign in</a>
                </p>

                <a href="/" class="back-link">
                    ← Back to Home
                </a>
            </div>

        </div>
    </div>
</div>

