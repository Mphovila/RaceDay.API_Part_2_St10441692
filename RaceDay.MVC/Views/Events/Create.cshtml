@model RaceDay.MVC.Controllers.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<style>
    body {
        background: #f4f6fb;
    }

    .form-container {
        max-width: 650px;
        margin: 40px auto;
        padding: 30px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
    }

    h1 {
        color: #172554;
    }

    label {
        display: block;
        margin-top: 16px;
        margin-bottom: 7px;
        font-weight: 600;
        color: #334155;
    }

    input, textarea, select {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
    }

    textarea {
        min-height: 100px;
    }

    .btn-main {
        background: #2563eb;
        color: white;
        border: 0;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 22px;
    }

    .error {
        background: #fee2e2;
        color: #991b1b;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
    }
</style>

<div class="form-container">

    <h1>Create an Event</h1>
    <p>Enter the details of your new event.</p>

    @if (ViewBag.Error != null)
    {
        <div class="error">@ViewBag.Error</div>
    }

    <form action="/Events/Create" method="post">
        @Html.AntiForgeryToken()

        <label for="EventName">Event Name</label>
        <input type="text" id="EventName" name="EventName"
               value="@Model?.EventName" required />

        <label for="Description">Description</label>
        <textarea id="Description" name="Description">@Model?.Description</textarea>

        <label for="EventType">Event Type</label>
        <select id="EventType" name="EventType" required>
            <option value="">Select event type</option>
            <option value="Running">Running</option>
            <option value="Walking">Walking</option>
            <option value="Cycling">Cycling</option>
            <option value="Swimming">Swimming</option>
            <option value="Other">Other</option>
        </select>

        <label for="EventDate">Event Date and Time</label>
        <input type="datetime-local" id="EventDate" name="EventDate"
               value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")"
               required />

        <label for="Location">Location</label>
        <input type="text" id="Location" name="Location"
               value="@Model?.Location" required />

        <label for="EntryFee">Entry Fee (R)</label>
        <input type="number" id="EntryFee" name="EntryFee"
               value="@Model.EntryFee" min="0" step="0.01" required />

        <button type="submit" class="btn-main">Create Event</button>

        <a href="/Events/Index" style="margin-left:12px;">Cancel</a>
    </form>
</div>
