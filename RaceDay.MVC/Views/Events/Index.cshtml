@model List<RaceDay.MVC.Controllers.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<style>
    body {
        background: #f4f6fb;
    }

    .events-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    .events-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .events-header h1 {
            color: #172554;
            margin: 0;
        }

    .event-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

        .event-card h3 {
            color: #172554;
            margin-top: 0;
        }

    .event-details {
        color: #64748b;
        line-height: 1.9;
    }

    .btn-main {
        background: #2563eb;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        border: 0;
        display: inline-block;
    }

    .btn-edit {
        background: #e0ecff;
        color: #1d4ed8;
        padding: 9px 15px;
        border-radius: 7px;
        text-decoration: none;
        border: 0;
    }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
        padding: 9px 15px;
        border-radius: 7px;
        border: 0;
        cursor: pointer;
    }

    .empty {
        background: white;
        padding: 35px;
        border-radius: 12px;
        text-align: center;
        color: #64748b;
    }

    .message {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
        background: #dcfce7;
        color: #166534;
    }

    .error {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
        background: #fee2e2;
        color: #991b1b;
    }
</style>

<div class="events-container">

    <div class="events-header">
        <div>
            <h1>Manage Events</h1>
            <p>View and manage your RaceDay events.</p>
        </div>

        <a href="/Events/Create" class="btn-main">+ Create Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="message">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="error">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="error">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <h3>No events available</h3>
            <p>Create your first event to get started.</p>
            <a href="/Events/Create" class="btn-main">Create an Event</a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="event-card">
                <h3>@item.EventName</h3>

                <div class="event-details">
                    <strong>Type:</strong> @item.EventType<br />
                    <strong>Date:</strong> @item.EventDate.ToString("dd MMMM yyyy, HH:mm")<br />
                    <strong>Location:</strong> @item.Location<br />
                    <strong>Entry Fee:</strong> R @item.EntryFee.ToString("N2")<br />
                    <strong>Description:</strong> @(item.Description ?? "No description provided")
                </div>

                <div style="display:flex; gap:10px; margin-top:18px; flex-wrap:wrap;">
                    <a href="/Events/Edit/@item.EventId" class="btn-edit">Edit</a>

                    <form action="/Events/Delete/@item.EventId" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this event?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-delete">Delete</button>
                    </form>
                </div>
            </div>
        }
    }

    <p><a href="/Dashboard/Organiser">← Back to Dashboard</a></p>

</div>
