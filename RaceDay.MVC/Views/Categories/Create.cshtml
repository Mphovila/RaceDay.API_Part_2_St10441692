@model RaceDay.MVC.Controllers.CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
    var events = ViewBag.Events as List<RaceDay.MVC.Controllers.EventOption>
                 ?? new List<RaceDay.MVC.Controllers.EventOption>();
}

<div class="container mt-4">
    <h2>Create Category</h2>
    <p>Add a new category to one of your events.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form method="post" action="/Categories/Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Select Event</label>
            <select name="EventId" class="form-control" required>
                <option value="">-- Select an event --</option>

                @foreach (var eventItem in events)
                {
                    <option value="@eventItem.EventId"
                            selected="@(Model.EventId == eventItem.EventId)">
                        @eventItem.EventName
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input type="text"
                   name="CategoryName"
                   class="form-control"
                   value="@Model.CategoryName"
                   placeholder="e.g. 10km Open"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Distance (km)</label>
            <input type="number"
                   name="Distance"
                   class="form-control"
                   value="@Model.Distance"
                   min="0.01"
                   step="0.01"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Entry Fee (R)</label>
            <input type="number"
                   name="EntryFee"
                   class="form-control"
                   value="@Model.EntryFee"
                   min="0"
                   step="0.01"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Maximum Participants</label>
            <input type="number"
                   name="MaximumParticipants"
                   class="form-control"
                   value="@Model.MaximumParticipants"
                   min="1"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Category
        </button>

        <a href="/Categories/Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
